this is a terminal to run this on linux open your previous terminal and paste this

cd $(dirname $(find ~/Desktop -name "CMakeLists.txt" | head -n 1)) && mkdir -p src include/mysh && mv -n *.cpp src/ 2>/dev/null; mv -n *.hpp include/mysh/ 2>/dev/null; rm -rf build && mkdir build && cd build && cmake .. && make && ./mysh
